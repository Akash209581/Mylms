# Copy this file to .env and replace the placeholder values with your own secrets.
# Do not commit .env to version control.

# Local PostgreSQL example
# DATABASE_URL=postgres://postgres:password@localhost:5432/lms

# Neon PostgreSQL example (pooler)
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Use one DATABASE_URL value for your active environment.
DATABASE_URL=postgres://postgres:password@localhost:5432/lms

# Optional safety fallback. If remote DATABASE_URL is unreachable, app will try this.
# Useful when your network blocks outbound port 5432 to cloud hosts.
# FALLBACK_DATABASE_URL=postgres://postgres:password@localhost:5432/lms
JWT_SECRET=your_jwt_secret_here_make_it_long_and_secure
FRONTEND_URL=http://localhost:3000
PORT=3001
NODE_ENV=development
